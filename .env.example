AMPLIFY_OUTPUT_USD_PER_MILLION=
VRP_BUDGET_USD=5
VRP_MAX_CALLS=100
VRP_PORT=8000
# Optional credentials for public research services:
OPENALEX_API_KEY=
S2_API_KEY=
